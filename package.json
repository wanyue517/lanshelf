{
  "name": "lanshelf",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny shared shelf for your local network",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && vue-tsc --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && vue-tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "archiver": "^7.0.0",
    "bonjour-service": "^1.3.0",
    "vue": "^3.5.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^9.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vue-tsc": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "online.wanyue.lanshelf",
    "productName": "LanShelf",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "win": { "target": ["nsis"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
