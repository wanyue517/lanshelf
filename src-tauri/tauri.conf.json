{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LanShelf",
  "version": "0.1.0",
  "identifier": "online.wanyue.lanshelf",
  "build": {
    "beforeDevCommand": "npm run build:frontend-dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "LanShelf",
      "width": 196,
      "height": 52,
      "resizable": false,
      "maximizable": false,
      "minimizable": false,
      "center": true,
      "visible": true,
      "transparent": true,
      "decorations": false,
      "alwaysOnTop": true,
      "skipTaskbar": true,
      "dragDropEnabled": true,
      "backgroundColor": "#00000000"
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
